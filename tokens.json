{
  "$schema": "https://schemas.tokens.studio/latest/tokens-schema.json",
  "color": {
    "gray": {
      "$type": "color",
      "$value": "#505050"
    },
    "textGray": {
      "$type": "color",
      "$value": "#959595"
    },
    "green": {
      "$type": "color",
      "$value": "#2E3C2B"
    },
    "orange": {
      "$type": "color",
      "$value": "#D78B32"
    },
    "lightOrange": {
      "$type": "color",
      "$value": "#FFB000"
    },
    "black": {
      "$type": "color",
      "$value": "#252525"
    },
    "sand": {
      "$type": "color",
      "$value": "#D3C69E"
    },
    "tan": {
      "$type": "color",
      "$value": "#EBE4CF"
    },
    "brown": {
      "$type": "color",
      "$value": "#322E2E"
    },
    "opaqueOrange": {
      "$type": "color",
      "$value": "rgba(215, 139, 50, 0.57)"
    },
    "lightTan": {
      "$type": "color",
      "$value": "#FBF9F2"
    },
    "white": {
      "$type": "color",
      "$value": "#FFFFFF"
    }
  },
  "font": {
    "family": {
      "primary": {
        "$type": "fontFamily",
        "$value": ["Syne", "sans-serif"]
      },
      "secondary": {
        "$type": "fontFamily",
        "$value": ["Brygada 1918", "serif"]
      },
      "tertiary": {
        "$type": "fontFamily",
        "$value": ["Syne Bold", "sans-serif"]
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      },
      "extrabold": {
        "$type": "fontWeight",
        "$value": 800
      }
    },
    "source": {
      "googleFontsUrl": {
        "$type": "string",
        "$value": "https://fonts.googleapis.com/css2?family=Brygada+1918:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Syne:wght@400;500;600;700;800&display=swap"
      }
    }
  }
}
