{
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"styles": ["styles/*"],
			"lib": ["lib/*"],
			"components/*": ["components/*"]
		},
		"target": "es5",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": false,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "preserve"
	},
	"include": ["next-env.d.ts", "pages/**/*", "styles/**/*"],
	"exclude": ["node_modules/*", "old_pages/*", "components/*", "lib/*", "hooks/*"]
}
